# Added by cargo
# The 'target' directory is where Cargo places all generated artifacts and compiled code.
# You never want to commit this as it can grow to several gigabytes.
/target

# Remove this line if you want to log your build directory (not recommended)
target/

# These files are generated by the compiler during tests and profiling
*.rs.bk
*.pcode

# IDE and Editor configurations (Optional but recommended)
.idea/
.vscode/
*.swp
*.swo

# OS-specific files
.DS_Store
Thumbs.db
